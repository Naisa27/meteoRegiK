# Справочные/примерные Excel-файлы — тяжёлые, не нужны в git
.claude/docs/*.xlsx
.claude/docs/*.xls

# Python / uv
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
build/
dist/
*.egg-info/

# Локальная рабочая БД — не сид: справочники stations/ru_regions бандлятся с
# приложением как sqlite-шаблон (src/meteoregik/seed_data/seed.sqlite3) и
# копируются db/seed.py при первом запуске, сам рабочий файл БД в git не
# нужен (см. plan.md).
/meteoregik.sqlite3
/meteoregik.sqlite3-wal
/meteoregik.sqlite3-shm

# Локальные пользовательские настройки интерфейса (preferences.py) — рядом с БД
/meteoregik_settings.json

# Внутренняя документация разработки (ТЗ, план, инструкции для Claude) —
# репозиторий публичный, держим только локально.
/CLAUDE.md
.claude/docs/

# Копия базы, которую приложение делает перед обновлением (db/migrations.py)
*_до_обновления.sqlite3
